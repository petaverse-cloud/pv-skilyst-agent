#!/usr/bin/env python3
"""Launcher for the Skilyst runtime -- no install step required.

    ./bin/skilyst run skilyst/video-15s --request "…"

Set SKILYST_SRC to point at a different checkout, and SKILYST_DEV_PROFILE to a
profile directory whose .env holds BEEHIVE_PLATFORM_* during development.
"""
import os
import sys
from pathlib import Path

src = Path(os.environ.get("SKILYST_SRC") or Path(__file__).resolve().parents[1] / "src")
if not (src / "cli.py").is_file():
    sys.exit(f"skilyst: runtime source not found at {src} (set SKILYST_SRC)")
sys.path.insert(0, str(src))

from cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
